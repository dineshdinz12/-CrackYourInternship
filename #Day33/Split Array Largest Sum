410. Split Array Largest Sum

int canSplit(int* nums, int numsSize, int maxSum, int k) {
    int currentSum = 0;
    int subarrays = 1; 

    for (int i = 0; i < numsSize; i++) {
        if (currentSum + nums[i] > maxSum) {
            subarrays++;
            currentSum = nums[i]; 
            if (subarrays > k) {
                return 0; 
            }
        } else {
            currentSum += nums[i];
        }
    }

    return 1; 
}

int splitArray(int* nums, int numsSize, int k) {
    int low = INT_MIN;
    int high = 0;

    for (int i = 0; i < numsSize; i++) {
        if (nums[i] > low) {
            low = nums[i];
        }
        high += nums[i];
    }

    while (low < high) {
        int mid = low + (high - low) / 2;

        if (canSplit(nums, numsSize, mid, k)) {
            high = mid; 
        } else {
            low = mid + 1; 
        }
    }

    return low;
}
