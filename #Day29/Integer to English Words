273. Integer to English Words


const char *below_20[] = {"", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine",
                         "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", 
                         "Seventeen", "Eighteen", "Nineteen"};

const char *tens[] = {"", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety"};

const char *thousands[] = {"", "Thousand", "Million", "Billion"};

void helper(int num, char *result) {
    if (num >= 100) {
        strcat(result, below_20[num / 100]);
        strcat(result, " Hundred ");
        num %= 100;
    }
    if (num >= 20) {
        strcat(result, tens[num / 10]);
        strcat(result, " ");
        num %= 10;
    }
    if (num > 0) {
        strcat(result, below_20[num]);
        strcat(result, " ");
    }
}

char* numberToWords(int num) {
    if (num == 0) {
        char *zero = (char*)malloc(5 * sizeof(char));
        strcpy(zero, "Zero");
        return zero;
    }

    char *result = (char*)malloc(1024 * sizeof(char));
    result[0] = '\0'; 

    int i = 0;
    while (num > 0) {
        if (num % 1000 != 0) {
            char current[1024] = "";
            helper(num % 1000, current);
            if (thousands[i][0] != '\0') {
                strcat(current, thousands[i]);
                strcat(current, " ");
            }

            strcat(current, result);
            strcpy(result, current);
        }
        num /= 1000;
        i++;
    }

    result[strlen(result) - 1] = '\0';
    return result;
}
