907. Sum of Subarray Minimums

class Solution {
public:
    int sumSubarrayMins(std::vector<int>& arr) {
        int n = arr.size();
        std::vector<int> ple(n, -1); 
        std::vector<int> nle(n, n);
        std::stack<int> st;
        const int MOD = 1e9 + 7;
        
        for (int i = 0; i < n; ++i) {
            while (!st.empty() && arr[st.top()] > arr[i]) {
                st.pop();
            }
            ple[i] = st.empty() ? -1 : st.top();
            st.push(i);
        }
        
        while (!st.empty()) st.pop();
        
    
        for (int i = n - 1; i >= 0; --i) {
            while (!st.empty() && arr[st.top()] >= arr[i]) {
                st.pop();
            }
            nle[i] = st.empty() ? n : st.top();
            st.push(i);
        }
       
        long long result = 0;
        for (int i = 0; i < n; ++i) {
            int leftCount = i - ple[i];
            int rightCount = nle[i] - i;
            result = (result + static_cast<long long>(arr[i]) * leftCount * rightCount) % MOD;
        }
        
        return static_cast<int>(result);
    }
};
